<?xml version="1.0" encoding="utf-8"?>
<!-- The relay runs as plain ws:// on a developer machine or LAN box during
     prototyping, so cleartext is allowed. Lock this down (cleartext off, pin
     the relay host) before any production build. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
