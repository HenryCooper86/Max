{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://max.neuehct.dev/protocol/agent-events.schema.json",
  "title": "Max helmet relay protocol",
  "description": "Authoritative discriminants and required fields for JSON events exchanged over /agent.",
  "$defs": {
    "ClientEvent": {
      "oneOf": [
        {
          "title": "SessionStart",
          "type": "object",
          "properties": {
            "type": {
              "const": "session.start"
            },
            "sampleRate": {
              "type": "number"
            },
            "channels": {
              "type": "number"
            }
          },
          "required": ["type", "sampleRate", "channels"]
        },
        {
          "title": "AudioStart",
          "type": "object",
          "properties": {
            "type": {
              "const": "audio.start"
            }
          },
          "required": ["type"]
        },
        {
          "title": "AudioStop",
          "type": "object",
          "properties": {
            "type": {
              "const": "audio.stop"
            }
          },
          "required": ["type"]
        },
        {
          "title": "GuidedDemo",
          "type": "object",
          "properties": {
            "type": {
              "const": "demo.guided"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": ["type", "enabled"]
        },
        {
          "title": "LocationUpdate",
          "type": "object",
          "properties": {
            "type": {
              "const": "location.update"
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            }
          },
          "required": ["type", "lat", "lon"]
        },
        {
          "title": "TestingMetric",
          "type": "object",
          "properties": {
            "type": {
              "const": "testing.metric"
            }
          },
          "required": ["type"]
        },
        {
          "title": "TurnFeedback",
          "type": "object",
          "properties": {
            "type": {
              "const": "turn.feedback"
            },
            "turnId": {
              "type": "string",
              "minLength": 1
            },
            "speaker": {
              "enum": ["rider", "agent"]
            },
            "text": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": ["type", "turnId", "speaker", "text", "reason"]
        },
        {
          "title": "DeviceResult",
          "type": "object",
          "properties": {
            "type": {
              "const": "device.result"
            },
            "commandId": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": ["ok", "failed", "denied", "unsupported"]
            },
            "reason": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": ["type", "commandId", "status"]
        },
        {
          "title": "HazardReport",
          "type": "object",
          "properties": {
            "type": {
              "const": "hazard.report"
            },
            "threat": {
              "type": "string"
            },
            "direction": {
              "type": "string"
            },
            "severity": {
              "enum": ["caution", "critical"]
            },
            "label": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "advice": {
              "type": "string"
            },
            "ttcSeconds": {
              "type": "number"
            },
            "latencyMs": {
              "type": "number"
            }
          },
          "required": ["type", "threat", "direction", "severity", "label", "message", "advice"]
        }
      ]
    },
    "AgentEvent": {
      "oneOf": [
        {
          "title": "SessionStarted",
          "type": "object",
          "properties": {
            "type": {
              "const": "session.started"
            },
            "provider": {
              "type": "string"
            },
            "mode": {
              "enum": ["mock", "live"]
            },
            "capabilities": {
              "type": "object"
            }
          },
          "required": ["type", "provider", "mode", "capabilities"]
        },
        {
          "title": "Connection",
          "type": "object",
          "properties": {
            "type": {
              "const": "connection"
            },
            "state": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": ["type", "state", "detail"]
        },
        {
          "title": "Status",
          "type": "object",
          "properties": {
            "type": {
              "const": "status"
            },
            "state": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": ["type", "state", "detail"]
        },
        {
          "title": "Transcript",
          "type": "object",
          "properties": {
            "type": {
              "const": "transcript"
            },
            "turnId": {
              "type": "string",
              "minLength": 1
            },
            "deliveryId": {
              "type": "string",
              "minLength": 1
            },
            "speaker": {
              "enum": ["rider", "agent"]
            },
            "text": {
              "type": "string"
            },
            "final": {
              "type": "boolean"
            },
            "useBrowserSpeech": {
              "type": "boolean"
            }
          },
          "required": ["type", "turnId", "deliveryId", "speaker", "text"]
        },
        {
          "title": "Metric",
          "type": "object",
          "properties": {
            "type": {
              "const": "metric"
            },
            "latencyMs": {
              "type": "number"
            }
          },
          "required": ["type"]
        },
        {
          "title": "Weather",
          "type": "object",
          "properties": {
            "type": {
              "const": "weather"
            },
            "description": {
              "type": "string"
            },
            "temperatureC": {
              "type": "number"
            },
            "windSpeedKmh": {
              "type": "number"
            },
            "isDay": {
              "type": ["boolean", "number"]
            }
          },
          "required": ["type", "description"]
        },
        {
          "title": "RideContext",
          "type": "object",
          "properties": {
            "type": {
              "const": "ride.context"
            },
            "mode": {
              "type": "string"
            },
            "modeLabel": {
              "type": "string"
            },
            "scenario": {
              "type": "string"
            },
            "scenarioLabel": {
              "type": "string"
            },
            "hazardLevel": {
              "type": "string"
            },
            "glanceableFocus": {
              "type": "string"
            }
          },
          "required": ["type", "mode", "modeLabel", "scenario", "scenarioLabel", "hazardLevel", "glanceableFocus"]
        },
        {
          "title": "SessionMemory",
          "type": "object",
          "properties": {
            "type": {
              "const": "session.memory"
            },
            "language": {
              "enum": ["zh", "en"]
            },
            "responseMode": {
              "enum": ["concise", "normal", "emergency"]
            }
          },
          "required": ["type", "language", "responseMode"]
        },
        {
          "title": "Telemetry",
          "type": "object",
          "properties": {
            "type": {
              "const": "telemetry"
            },
            "asrMs": {
              "type": "number"
            },
            "thinkMs": {
              "type": "number"
            },
            "firstAudioMs": {
              "type": "number"
            },
            "totalMs": {
              "type": "number"
            }
          },
          "required": ["type"]
        },
        {
          "title": "HazardAlert",
          "type": "object",
          "properties": {
            "type": {
              "const": "hazard.alert"
            },
            "threat": {
              "type": "string"
            },
            "direction": {
              "type": "string"
            },
            "severity": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "advice": {
              "type": "string"
            },
            "ttcSeconds": {
              "type": "number"
            },
            "interrupt": {
              "type": "boolean"
            }
          },
          "required": ["type", "threat", "direction", "severity", "label", "message", "advice"]
        },
        {
          "title": "DeviceCommand",
          "type": "object",
          "properties": {
            "type": {
              "const": "device.command"
            },
            "commandId": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "enum": [
                "torch.set",
                "volume.set",
                "music.control",
                "sms.compose",
                "call.dial",
                "destination.show",
                "camera.photo",
                "camera.record",
                "gallery.open",
                "navigation.start",
                "navigation.stop"
              ]
            },
            "args": {
              "type": "object"
            },
            "tier": {
              "enum": ["low", "high"]
            }
          },
          "required": ["type", "commandId", "action", "args", "tier"]
        },
        {
          "title": "Error",
          "type": "object",
          "properties": {
            "type": {
              "const": "error"
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["type", "message"]
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ClientEvent"
    },
    {
      "$ref": "#/$defs/AgentEvent"
    }
  ]
}
