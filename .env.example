VOICE_PROVIDER=mock

# Set VOICE_PROVIDER=doubao for the Doubao Speech realtime dialogue WebSocket.
# Official realtime dialog defaults:
#   DOUBAO_AGENT_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
#   DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_AGENT_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
DOUBAO_RESOURCE_ID=volc.speech.dialog

# Doubao Speech API-key mode from the Speech console.
# Newer Speech console authentication sends only X-Api-Key plus X-Api-Resource-Id.
# The key ID is kept locally for operator reference and is not sent.
DOUBAO_API_KEY_ID=
DOUBAO_API_KEY=

# Legacy speech app credential mode. Used only when DOUBAO_API_KEY is empty.
DOUBAO_APP_ID=
DOUBAO_APP_KEY=
DOUBAO_ACCESS_KEY=
DOUBAO_BOT_NAME=Max
DOUBAO_SYSTEM_ROLE=你是 Max，一位友好、冷静、以安全为先的摩托车头盔 AI 助手。你的名字保持 Max，角色保持 Motorcycle Helmet AI assistant。默认语言是中文，第二语言是 English；如果骑手明确使用英文，可以用英文回答。只允许中文和 English 两种语言，不要使用其他语言。如果骑手使用其他语言或要求你使用其他语言，请用中文简短说明：我只支持中文和 English。帮助骑手理解摩托车、导航、天气、路况、附近停靠点和骑行安全事项。回答要简短、清晰、适合免手操作。拍照、录像、导航、开关手电筒、调整音量、播放音乐、拨号、发短信等都是语音免手操作，本来就是为骑行中使用而设计的，属于安全的免手功能；骑手在骑行中要求这些操作时要直接执行，不要当作分心请求拒绝，也不要让骑手停车再做。只有当请求真正危险、需要骑手用手长时间盯着屏幕操作、或超出头盔助手范围时，才先保护骑行安全并给出更安全的替代方案。男声和女声只是当前会话音色，必须共享同一个 Max 角色、同一语言规则、同一安全策略和同一默认行为。
DOUBAO_REALTIME_MODEL=1.2.1.1
# keep_alive uses server VAD; EndASR is sent only in push_to_talk mode.
DOUBAO_INPUT_MODE=keep_alive
# Realtime turn detection and recognition quality.
DOUBAO_VAD_END_MS=900
DOUBAO_ASR_TWOPASS=on
# Output normalization/tuning (provider-supported ranges: -50..100).
DOUBAO_LOUDNESS_NORMALIZATION=on
DOUBAO_SPEECH_RATE=8
DOUBAO_LOUDNESS_RATE=10
# Safety and transport deadlines.
DOUBAO_AUDIT_RESPONSE=这个请求我不能帮助执行。请把注意力放在安全骑行上。
DOUBAO_CONNECTION_TIMEOUT_MS=8000
DOUBAO_SESSION_TIMEOUT_MS=10000
# Recover a completed addressed utterance whose reply never starts (no action replay).
DOUBAO_REPLY_TIMEOUT_MS=10000
# Conservative network/playback allowance used when truncating an interrupted reply.
DOUBAO_PLAYBACK_SAFETY_MS=350
# Realtime speaker IDs from the Doubao 音色列表. The 女声/男声 toggle in the UI
# picks between these; verify the IDs are enabled for your speech-dialog resource.
DOUBAO_VOICE=zh_female_vv_jupiter_bigtts
DOUBAO_VOICE_MALE=zh_male_yunzhou_jupiter_bigtts

# Optional fallback weather location used when browser geolocation is denied.
# Leave blank if Max should only use real rider coordinates.
DEFAULT_RIDER_LAT=
DEFAULT_RIDER_LON=

# Wake word: the live Doubao agent only replies when addressed by name ("Max").
# Set to off to make it answer every utterance again. (Mock provider ignores this.)
AGENT_WAKE_WORD=on

# --- Vision (Ark) ----------------------------------------------------------
# Ark chat-completions API key for vision questions ("前面那个路牌写的什么").
# Leave empty to use the mock vision provider (works keylessly with placeholder answers).
ARK_API_KEY=
# Ark chat-completions base URL. Defaults to the official China endpoint.
ARK_BASE_URL=
# Ark vision-capable model ID.
ARK_MODEL=

# --- Navigation (Amap) -------------------------------------------------------
# Amap Web 服务 key for relay-side routing (place search + driving directions).
# Leave empty to use the built-in mock route provider (works keylessly).
AMAP_API_KEY=
# Amap Web 端 (JS API) key served to the browser HUD for the live route map;
# the map panel is hidden without it.
AMAP_JS_KEY=
# JS API 安全密钥 paired with AMAP_JS_KEY — used only inside the server-side
# /_AMapService proxy to sign requests; never sent to the browser.
AMAP_JS_SECRET=
# Requests one client address may send through the /_AMapService proxy per minute
# (1 to 10000). A map draws dozens of tiles a minute, so this sits far above the
# login limits: it bounds what one address can spend of the Amap quota.
AMAP_PROXY_PER_MINUTE=600

# --- Relay security ---------------------------------------------------------
# Shared secret for the /agent WebSocket. Clients connect with ?token=<value>
# (web: open the HUD once with ?token=… in the page URL and it is remembered;
# iOS/Android: paste it into the 认证令牌 field in Settings). Leave empty to
# keep the relay open (fine locally; risky on a public server with live
# credentials, since anyone who finds the URL can burn Doubao quota).
RELAY_AUTH_TOKEN=

# Browser Origin allowlist for /agent, comma-separated (e.g.
# https://max.example.com,https://hud.example.com). Empty allows any origin.
# Native apps send no Origin header and are governed by the token instead.
RELAY_ALLOWED_ORIGINS=

# WebSocket upgrade attempts allowed per client IP per minute (0 disables).
# Enforced as a true sliding 60s window (no burst at the minute boundary).
RELAY_CONN_PER_MINUTE=30

# Maximum size of one reassembled WebSocket message in bytes, 320 KiB to 1 MiB
# (values outside are clamped). It must stay above the 256 KiB limit on one
# client JSON event (a camera frame), and it keeps ws's 100 MiB default from
# exhausting a small relay host.
RELAY_MAX_PAYLOAD_BYTES=393216

# Set to on ONLY behind a trusted reverse proxy (e.g. the Caddy hop in the
# documented deploy), so rate limiting reads the real client IP from
# X-Forwarded-For instead of the proxy's socket address. IMPORTANT: leaving this
# off behind a proxy makes every client share one IP, collapsing the per-IP
# limit into a global one that can lock everyone out. The relay logs a warning
# (and /ready lists "proxy-headers-untrusted") the first time a request arrives
# with X-Forwarded-For or Forwarded while this is off. With it on and no proxy,
# clients can forge their address, which is why the default stays off.
RELAY_TRUST_PROXY=off

# Number of trusted reverse-proxy hops in front of the relay (default 1 = a
# single Caddy). The real client IP is taken this many entries from the right of
# X-Forwarded-For; entries further left are client-supplied and never trusted.
# Only used when RELAY_TRUST_PROXY=on.
RELAY_TRUSTED_PROXY_HOPS=1

# --- User accounts ------------------------------------------------------------
# Testers register/log in via the web HUD (POST /auth/register, /auth/login).
# The FIRST registered account becomes the admin; auth turns on automatically
# once any account exists (testing APIs then require a login or the relay
# token, and clears require an admin). Set AUTH_REGISTRATION=off once the team
# is onboarded so strangers can't self-register on a reachable relay.
AUTH_REGISTRATION=on

# Login session lifetime in days (1-365).
AUTH_SESSION_DAYS=30

# Login/registration attempts allowed per client IP per minute (3-1000),
# counted separately for relay login/registration, password change, Max Cloud
# login/sign-up, token minting and Cloud tool tests. Failed logins are also
# counted per account name: after 5 failures the name is locked for 1 s, then
# 2 s, 4 s, ... up to 15 min; a successful login clears it.
AUTH_ATTEMPTS_PER_MINUTE=10

# Where users/sessions are stored (JSON, written atomically; login session
# tokens are kept only as SHA-256 hashes). Defaults to
# ~/.max-relay/accounts.json; set to off to keep accounts
# in memory only (they vanish on restart).
# ACCOUNTS_FILE=

# Durable per-user conversation memory (latest safe session snapshot plus a
# bounded recent-turn window). Only authenticated users receive persistent
# memory; anonymous/operator-token sessions are never pooled together.
# Defaults to ~/.max-relay/user-memory.json. Set to off to keep
# only the existing client-echoed, current-session memory.
# USER_MEMORY_FILE=

# Indexed QA evidence + operational state (runs, reviews, policies, audit,
# approved baseline). Defaults to ~/.max-relay/testing.sqlite.
# Set to off only for ephemeral local/test runs.
# TESTING_DATABASE=

# Append-oriented completed-session recovery archive. Defaults to
# ~/.max-relay/sessions.jsonl. Set the directory to off to disable
# the archive; SQLite remains authoritative unless TESTING_DATABASE is also off.
# TESTING_HISTORY_DIR=
# TESTING_HISTORY_MAX_SESSIONS=200
# Optional recovery-archive retention cap; unset means retain all JSONL
# evidence. This does not delete the authoritative SQLite index.
# TESTING_ARCHIVE_MAX_SESSIONS=

# Liveness heartbeat for /agent clients (ms). The relay pings on this cadence
# and terminates any client that misses a full interval without a pong —
# half-open TCP links (phone lost signal) would otherwise hold their Doubao
# upstream slot forever. 0 disables pinging.
RELAY_HEARTBEAT_MS=30000

# Close /agent sessions with no client traffic (events or mic frames) for this
# long (ms), freeing the upstream slot held by a forgotten tab. Clients receive
# close code 4001 (IDLE_CLOSE_CODE) and stay offline instead of auto-reconnecting.
# 0 disables the idle timeout.
RELAY_IDLE_TIMEOUT_MS=600000

# Crash escalation delivery channel. "log" (default) records incidents in the
# testing audit but sends no SMS — the crash.ack honestly reports "unconfigured".
# CRASH_NOTIFIER=log

# --- Session behaviour ------------------------------------------------------
# How often a live session re-fetches Open-Meteo weather mid-ride (ms).
# 0 disables the refresh; the HUD then keeps the session-start snapshot.
WEATHER_REFRESH_MS=600000

# Base wait for Doubao TTS audio before the browser-speech fallback kicks in
# (ms). The relay adapts upward from this floor using the measured first-audio
# latency of the previous turn, so slow links don't trigger spurious fallbacks.
TTS_FALLBACK_MS=1800

# Server log verbosity: debug | info | warn | error (default info). ASR text is
# intentionally never logged; debug reports only lengths and wake decisions.
LOG_LEVEL=info

# Log line format: text (default) or json. json writes one object per line with
# time, level, scope, message and the event's fields, for log collectors.
# LOG_FORMAT=json

# Bearer token for GET /metrics (Prometheus text format: relay counters, open
# sockets and sessions, uptime). Unset keeps the endpoint off (404). Use its
# own long random value, not RELAY_AUTH_TOKEN: openssl rand -hex 32
# Scrape with: Authorization: Bearer <METRICS_TOKEN>
# METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Make it yours
# ---------------------------------------------------------------------------
# `npm run setup` asks a few questions and writes assistant.config.json + .env.
#
# Who the assistant is (name, device, wake word, languages, design template,
# accent colour, voice equaliser, persona) lives in assistant.config.json — copy
# assistant.config.example.json. Without that file the relay is the original
# "Max" motorcycle-helmet assistant. Point elsewhere with:
# ASSISTANT_CONFIG=/path/to/assistant.config.json
#
# VOICE_PROVIDER (top of this file) picks the default voice backend:
#   mock      keyless scripted demo
#   doubao    Doubao realtime (settings below)
#   openai    OpenAI Realtime
#   grok      xAI Grok Voice
#   gemini    Google Gemini Live
#   pipeline  Whisper speech-to-text -> any chat model -> any text-to-speech
# Every backend that has a key is also offered in the apps' settings so the
# wearer can switch per session. Pin everyone to VOICE_PROVIDER with:
# VOICE_PROVIDER_SWITCHING=off

# The relay's own turn detector in front of OpenAI Realtime, Gemini Live and
# Grok: a Max Speech server decides when the user has finished speaking,
# from how the last words sounded, not only from the silence. docs/backends.md
# TURN_DETECTOR=max-speech
# The Max Speech server (MAX_SPEECH_URL when not set) and its key, if any.
# TURN_DETECTOR_URL=http://localhost:8790
# Its key. MAX_SPEECH_API_KEY is used only when TURN_DETECTOR_URL is not set.
# TURN_DETECTOR_API_KEY=
# low | normal | high: how soon a pause may end the turn.
# TURN_DETECTOR_EAGERNESS=

# OpenAI Realtime
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_VOICE=marin
# OPENAI_VOICE_MALE=cedar
# When the user has finished speaking: server_vad (a silence) or semantic_vad
# (also the words: it waits when the user is mid-thought). docs/backends.md
# OPENAI_TURN_DETECTION=server_vad
# With semantic_vad: low | medium | high | auto.
# OPENAI_TURN_EAGERNESS=
# With server_vad: 0-1, the silence that ends a turn (ms), audio kept from before speech (ms).
# OPENAI_VAD_THRESHOLD=
# OPENAI_VAD_SILENCE_MS=
# OPENAI_VAD_PREFIX_MS=
# near_field (headset, phone at the ear) | far_field (laptop, room) | off.
# OPENAI_NOISE_REDUCTION=

# xAI Grok Voice
# XAI_API_KEY=
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_VOICE=eve
# XAI_VOICE_MALE=rex

# Google Gemini Live
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_VOICE=Aoede
# GEMINI_VOICE_MALE=Puck
# Speech detection: high | low for each, and durations in ms. docs/backends.md
# GEMINI_START_SENSITIVITY=
# GEMINI_END_SENSITIVITY=
# GEMINI_VAD_SILENCE_MS=
# GEMINI_VAD_PREFIX_MS=

# Whisper pipeline. Each stage is an OpenAI-compatible endpoint and may point
# at a different vendor or a local server (no key needed for localhost).
# PIPELINE_API_KEY and PIPELINE_BASE_URL apply to every stage unless a stage
# overrides them; with neither set, OPENAI_API_KEY and api.openai.com are used.
# PIPELINE_API_KEY=
# PIPELINE_BASE_URL=https://api.openai.com/v1
# PIPELINE_STT_BASE_URL=   PIPELINE_STT_API_KEY=   PIPELINE_STT_MODEL=whisper-1
# PIPELINE_LLM_BASE_URL=   PIPELINE_LLM_API_KEY=   PIPELINE_LLM_MODEL=gpt-4o-mini
# on lets users show the assistant pictures (image.input). Only for a chat model that can see them:
# PIPELINE_LLM_IMAGES=off
# PIPELINE_TTS_BASE_URL=   PIPELINE_TTS_API_KEY=   PIPELINE_TTS_MODEL=gpt-4o-mini-tts
# PIPELINE_TTS_VOICE=nova
# PIPELINE_TTS_VOICE_MALE=onyx
# The TTS stage must return raw PCM16 (response_format=pcm). Set its rate if not 24000:
# PIPELINE_TTS_SAMPLE_RATE=24000

# Camera questions on the OpenAI/Grok/Gemini/pipeline backends: any
# OpenAI-compatible vision model (falls back to ARK_* when unset).
# VISION_API_KEY=
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=

# Local, open-weight models (see docs/local-models.md and docker-compose.local-voice.yml).
#   local           Whisper-class speech-to-text -> any local chat model -> local text-to-speech
#   local-realtime  a self-hosted server that speaks the OpenAI Realtime protocol
#   max-speech      Max Speech (speech-server/) listens and speaks; LOCAL_LLM_* is the chat model
# LOCAL_VOICE=on
# LOCAL_STT_BASE_URL=http://localhost:8000/v1    LOCAL_STT_MODEL=Systran/faster-whisper-small
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1   LOCAL_LLM_MODEL=qwen3:8b
# LOCAL_LLM_REASONING_EFFORT=none                none skips a thinking model's hidden reasoning; default leaves it on
# LOCAL_LLM_IMAGES=off                           on lets users show pictures (local and max-speech); use a model that can see, e.g. gemma3:4b
# LOCAL_TTS_BASE_URL=http://localhost:8880/v1    LOCAL_TTS_MODEL=kokoro
# LOCAL_TTS_VOICE=af_heart
# LOCAL_TTS_VOICE_MALE=am_michael
# LOCAL_TTS_FORMAT=wav
# LOCAL_REALTIME_URL=ws://localhost:8000/v1/realtime
# LOCAL_REALTIME_MODEL=
# MAX_SPEECH_URL=ws://localhost:8790/v1/speech/session
# MAX_SPEECH_API_KEY=
# MAX_SPEECH_VOICE=

# Voice equaliser (ten bands + preamp). The default comes from assistant.config.json (voice.equalizer)
# or from the device preset. Wearers can tune it per session in Settings unless:
# VOICE_EQUALIZER_ADJUSTABLE=off

# Studio. Admins can edit the assistant from the app (Admin → Studio). What they
# save is written here, outside the app directory so a deploy does not erase it,
# and takes precedence over ./assistant.config.json. Voice backend keys and
# models entered in the Studio are stored there too (voice-backends.json, mode
# 600) and take precedence over the values in this file.
# STUDIO_DIR=~/.max-relay

# ---------------------------------------------------------------------------
# Usage and billing (docs/usage-and-billing.md)
# ---------------------------------------------------------------------------
# Voice minutes each user may use per calendar month (UTC). Users are the
# signed-in account or the userId on a session token; sessions without a user
# are never limited. Unset or 0: no limit. GET /v1/usage reports totals.
USAGE_MONTHLY_MINUTES=
# POSTed when each voice session ends: {"type":"session.usage", userId, seconds,
# minutes, toolCalls, ...}. Signed like tool webhooks when a secret is set.
USAGE_WEBHOOK_URL=
USAGE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Conversation records and analysis (docs/conversations.md)
# ---------------------------------------------------------------------------
# POSTed when each conversation ends: the transcript and, with the "analysis" key
# of assistant.config.json, a summary and extracted fields. HTTPS, or plain HTTP
# to a local or private host. Signed like tool webhooks when a secret is set.
# CONVERSATION_WEBHOOK_URL=
# CONVERSATION_WEBHOOK_SECRET=
# The same record, appended as one JSON object per line.
# CONVERSATION_LOG_FILE=
# Record the audio: "phone" for phone calls only, "on" for every conversation. One
# stereo WAV for each conversation (user left, assistant right), about 3.8 MB a minute.
# Check what the law requires you to tell people first (docs/conversations.md).
# CONVERSATION_RECORDING=phone
# CONVERSATION_RECORDING_DIR=/var/lib/max/recordings
# Delete recordings older than this many days. Unset: they are kept.
# CONVERSATION_RECORDING_KEEP_DAYS=30
# The chat model that runs "analysis": any OpenAI-compatible endpoint. Unset:
# the pipeline's chat model (PIPELINE_LLM_*, OPENAI_API_KEY), else the local one.
# ANALYSIS_LLM_BASE_URL=
# ANALYSIS_LLM_API_KEY=
# ANALYSIS_LLM_MODEL=
# The chat model that judges "guardrails" rules. Unset: the analysis model above.
# GUARDRAILS_LLM_BASE_URL=
# GUARDRAILS_LLM_API_KEY=
# GUARDRAILS_LLM_MODEL=

# Knowledge base: also search by meaning (hybrid with keyword search). Off unless the model is set.
# Any OpenAI-compatible /embeddings endpoint. The key falls back to OPENAI_API_KEY for the default URL only.
# KNOWLEDGE_EMBEDDINGS_MODEL=text-embedding-3-small
# KNOWLEDGE_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# KNOWLEDGE_EMBEDDINGS_API_KEY=
# Vectors are cached on disk so a restart embeds only what changed. A directory, or "off". Default: knowledge-embeddings
# inside the Studio directory (STUDIO_DIR, else ~/.max-relay).
# KNOWLEDGE_EMBEDDINGS_CACHE=
# The most passages that get embeddings. Above it the whole knowledge base stays on keyword search.
# KNOWLEDGE_MAX_PASSAGES=100000

# ---------------------------------------------------------------------------
# Tracing (docs/conversations.md#tracing)
# ---------------------------------------------------------------------------
# One OpenTelemetry trace per conversation, exported as OTLP over HTTP with JSON
# encoding. Tracing is on when an endpoint is set. The base URL gets /v1/traces
# added; the traces URL is used as it is. Headers are name=value,name2=value2
# with URL-encoded values.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_SERVICE_NAME=max-relay
# true turns tracing off, whatever else is set.
# OTEL_SDK_DISABLED=
# on adds what was said to the spans (redacted per "privacy.redact"). Off by default.
# MAX_TRACE_CONTENT=off

# ---------------------------------------------------------------------------
# Noise suppression (docs/configuration.md#noise-suppression)
# ---------------------------------------------------------------------------
# Cleans microphone audio in the relay before any backend hears it:
# phone = phone calls only, on = every session. Browsers already clean their
# own microphone, so phone is the usual choice.
# NOISE_SUPPRESSION=phone

# ---------------------------------------------------------------------------
# WebRTC transport for web clients (docs/webrtc.md)
# ---------------------------------------------------------------------------
# on lets the web SDK send audio over WebRTC (UDP, Opus) instead of the
# WebSocket, which holds up better on poor networks. Pages ask for it with
# transport: "webrtc" and fall back to the WebSocket where it cannot be used.
# WEBRTC=on
# The address clients reach this server at. Needed behind NAT (most clouds).
# WEBRTC_PUBLIC_IP=203.0.113.5
# The UDP ports to use. Open the same range in your firewall.
# WEBRTC_UDP_PORTS=50000-50100
# STUN and TURN servers for the relay. It contacts none unless you list them.
# WEBRTC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
# Simultaneous WebRTC sessions (1-5000). Further clients use the WebSocket.
# WEBRTC_MAX_SESSIONS=100

# ---------------------------------------------------------------------------
# Phone calls through Twilio (docs/telephony.md)
# ---------------------------------------------------------------------------
# Setting the auth token turns telephony on. Point the number's "A call comes in"
# webhook at POST https://<relay>/telephony/twilio/voice.
# TWILIO_AUTH_TOKEN=
# Needed to transfer calls and to place outbound calls (POST /v1/calls).
# TWILIO_ACCOUNT_SID=
# The number outbound calls come from, in E.164 form (+14155550100).
# TWILIO_PHONE_NUMBER=
# The relay's public address as Twilio reaches it. Set it behind a proxy or a tunnel.
# TELEPHONY_PUBLIC_URL=https://voice.example.com
# Where the assistant may transfer a call: name=number or name=sip:uri, comma-separated.
# Needs TWILIO_ACCOUNT_SID.
# TELEPHONY_TRANSFER_NUMBERS=support=+14155550123,sales=sip:sales@example.com
# Warm transfers (Twilio): "on" reads the assistant's summary of the call to whoever picks up,
# and brings the caller back to the assistant when nobody does. "confirm" also asks them to
# press a key, so that an answering machine cannot take the call.
# TELEPHONY_WARM_TRANSFER=on
# The line that asks for the key press, in your callers' language.
# TELEPHONY_TRANSFER_PROMPT=Press any key to take the call.
# Simultaneous calls (1-1000) on each carrier. Further calls get a busy signal.
# TELEPHONY_MAX_CALLS=20

# Where call campaigns (POST /v1/campaigns) are kept between restarts. Without it they
# live in memory and are lost at a restart. The file is written with mode 0600, and a
# journal beside it (<file>.journal) records each call before it is placed.
# CAMPAIGNS_FILE=/var/lib/max/campaigns.json

# Phone calls through Telnyx (docs/telephony.md#telnyx). Can be set beside Twilio.
# A secret of your own (16+ letters, digits, - or _) and your account's public key
# turn Telnyx on. Set the TeXML application's voice URL to
# https://<relay>/telephony/telnyx/voice?key=<this secret>.
# TELNYX_WEBHOOK_SECRET=
# Checks Telnyx's signature on every media stream. Required.
# TELNYX_PUBLIC_KEY=
# Needed to transfer calls and to place outbound calls (POST /v1/calls). Outbound
# calls also need TELEPHONY_PUBLIC_URL.
# TELNYX_API_KEY=
# TELNYX_ACCOUNT_SID=
# The TeXML application outbound calls are placed through.
# TELNYX_APPLICATION_SID=
# The number outbound calls come from, in E.164 form (+14155550100).
# TELNYX_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Max Cloud (docs/cloud.md): accounts, projects and prepaid balance at /console
# ---------------------------------------------------------------------------
# 32 random bytes (openssl rand -base64 32). Unset: Max Cloud is off.
# Encrypts customers' model keys and webhook secrets: back it up together with the data folder.
CLOUD_SECRET_KEY=
# While rotating CLOUD_SECRET_KEY: the old key, used only to read secrets not yet
# re-encrypted (npm run cloud:reencrypt). Remove it afterwards. See docs/cloud.md.
# CLOUD_SECRET_KEY_PREVIOUS=
# This relay's public address, for payment notifications.
CLOUD_PUBLIC_URL=
# Signup is by invitation (Admin → Accounts → Max Cloud invitations). "open": anyone may sign up.
# CLOUD_SIGNUP=open
# Conversation analysis for projects runs on each project's own vendor with its own model key. The chat model
# asked, per vendor (defaults shown):
# CLOUD_ANALYSIS_MODEL_OPENAI=gpt-4o-mini
# CLOUD_ANALYSIS_MODEL_GEMINI=gemini-3.8-flash
# CLOUD_ANALYSIS_MODEL_GROK=grok-4.3
# Or one model of your own for every project (any OpenAI-compatible endpoint; it is never sent a customer's key):
# CLOUD_ANALYSIS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CLOUD_ANALYSIS_LLM_MODEL=qwen3:8b
# CLOUD_ANALYSIS_LLM_API_KEY=
# WeChat Pay (API v3, Native). Needs a merchant account.
WECHATPAY_MCHID=
WECHATPAY_APPID=
WECHATPAY_CERT_SERIAL=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_API_V3_KEY=
WECHATPAY_PUBLIC_KEY=
WECHATPAY_PUBLIC_KEY_ID=
# Alipay (订单码支付). Needs a merchant account.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_PRODUCT_CODE=FACE_TO_FACE_PAYMENT
# Development only: a "Test payment" method that needs no merchant account.
# CLOUD_PAYMENTS_TEST=on
