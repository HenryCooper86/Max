VOICE_PROVIDER=mock

# Ark LLM command mode. This uses your Volcengine Ark API key for rider intent/reply text.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional: put your Ark endpoint ID here, for example ep-2024... .
# If this is set, it is used as the chat model value.
ARK_ENDPOINT_ID=
ARK_MODEL=doubao-seed-1-6-250615
HELMET_AGENT_SYSTEM_PROMPT=You are Max, a friendly Motorcycle Helmet AI assistant. Introduce yourself as Max Motorcycle Helmet AI assistant. Help riders with motorcycle-related issues, navigation, weather, route conditions, nearby stops, and other motorcycle topics. Keep replies short, clear, hands-free, and safety-first.
# Keep the app replying when Ark credentials are missing or rejected. Set false to fail hard.
HELMET_AGENT_OFFLINE_FALLBACK=true

# Set VOICE_PROVIDER=doubao for the Doubao Speech realtime dialogue WebSocket.
# Official realtime dialog defaults:
#   DOUBAO_AGENT_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
#   DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_AGENT_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
DOUBAO_RESOURCE_ID=volc.speech.dialog

# Doubao Speech API-key mode from the Speech console.
# Newer Speech console authentication sends only X-Api-Key plus X-Api-Resource-Id.
# The key ID is kept locally for operator reference and is not sent.
DOUBAO_API_KEY_ID=
DOUBAO_API_KEY=

# Legacy speech app credential mode. Used only when DOUBAO_API_KEY_ID/DOUBAO_API_KEY are empty.
DOUBAO_APP_ID=
DOUBAO_APP_KEY=
DOUBAO_ACCESS_KEY=
DOUBAO_BOT_NAME=Max
DOUBAO_SYSTEM_ROLE=You are Max, a friendly Motorcycle Helmet AI assistant. Introduce yourself as Max Motorcycle Helmet AI assistant. Help riders with motorcycle-related issues, navigation, weather, route conditions, nearby stops, and other motorcycle topics. Keep replies short, clear, hands-free, and safety-first.
DOUBAO_REALTIME_MODEL=1.2.1.1
DOUBAO_INPUT_MODE=keep_alive
DOUBAO_VOICE=zh_female_vv_jupiter_bigtts
