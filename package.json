{
  "name": "horizon-helmet-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "brand": "tsx scripts/brand.ts",
    "bench:audio": "tsx scripts/audio-bench/cli.ts",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "generate:protocol": "tsx scripts/generate-agent-protocol.ts",
    "check:protocol": "tsx scripts/generate-agent-protocol.ts --check",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:protocol && npm run format:check && npm run lint && npm run check:dead-code && npm run check:rdk && npm test && npm run test:fault-matrix && npm run build",
    "check:dead-code": "knip",
    "check:rdk": "tsc -p rdk/agent/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:rdk-vision": "python3 -m pytest -c rdk/vision/pytest.ini -m \"not hardware\" --strict-markers rdk/vision/tests",
    "test:watch": "vitest",
    "test:fault-matrix": "tsx scripts/testing-fault-matrix.ts",
    "test:release-gate": "tsx scripts/testing-release-gate.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multicast-dns": "^7.2.5",
    "tsx": "^4.19.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.27.0",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-test-renderer": "^19.2.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
