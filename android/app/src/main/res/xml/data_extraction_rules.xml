<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer on Android 12+
     (android:dataExtractionRules). Same allow-list as backup_rules.xml: only
     max_ui.xml (interface language, visor template, voice-display style) may
     leave the phone. Ride transcripts, account identity, tokens, the emergency
     contact, crash settings, captures and their metadata, the HUD pairing
     secret and the map privacy consent are personal or device-bound, so they
     are not copied to Google's cloud or to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="max_ui.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="max_ui.xml" />
    </device-transfer>
</data-extraction-rules>
