platform :ios, "17.0"
project "MaxHelmet.xcodeproj"

target "MaxHelmet" do
  pod "AMap3DMap-NO-IDFA", "~> 11.2"

  target "MaxHelmetTests" do
    inherit! :search_paths
  end
end

post_integrate do |installer|
  # AMap has no usable arm64-simulator binary. The app xcconfigs keep the
  # device framework flags while overriding simulator flags to system-only
  # dependencies. CocoaPods' aggregate static libraries would still be linked
  # by affected user targets on simulator, so remove just those redundant
  # aggregate-product references after every integration. The generated
  # xcconfigs remain the source of the device framework linkage.
  amap_pod_names = ["AMap3DMap-NO-IDFA", "AMapFoundation-NO-IDFA"]
  amap_framework_names = ["AMapFoundationKit", "MAMapKit"]
  projects_to_save = {}
  removed_products = []
  amap_aggregate_count = 0

  installer.aggregate_targets.each do |aggregate_target|
    related_targets = []
    pending_targets = [aggregate_target]
    seen_labels = {}
    until pending_targets.empty?
      target = pending_targets.shift
      next if seen_labels[target.label]

      seen_labels[target.label] = true
      related_targets << target
      pending_targets.concat(target.search_paths_aggregate_targets)
    end

    contains_amap = lambda do |pod_targets|
      pod_targets.any? do |pod_target|
        ([pod_target] + pod_target.recursive_dependent_targets).any? do |candidate|
          amap_pod_names.include?(candidate.pod_name)
        end
      end
    end
    directly_contains_amap = contains_amap.call(aggregate_target.pod_targets)
    depends_on_amap = contains_amap.call(related_targets.flat_map(&:pod_targets))
    next unless depends_on_amap

    amap_provider_targets = related_targets.select do |target|
      contains_amap.call(target.pod_targets)
    end
    amap_provider_targets.each do |provider_target|
      direct_link_settings = provider_target.xcconfigs.values.map do |xcconfig|
        xcconfig.to_hash.fetch("OTHER_LDFLAGS", "")
      end
      unless direct_link_settings.all? do |linker_flags|
        amap_framework_names.all? { |framework| linker_flags.include?("-framework \"#{framework}\"") }
      end
        raise Pod::Informative,
              "Expected direct iPhoneOS AMap framework linker settings for #{provider_target.label}; " \
              "refusing to remove its redundant aggregate product link."
      end
    end

    # A target that only inherits AMap search paths has no pod sources of its
    # own, so its aggregate product is redundant too. Leave an aggregate that
    # owns unrelated pod targets untouched.
    next unless directly_contains_amap || aggregate_target.pod_targets.empty?

    amap_aggregate_count += 1

    pods_target = installer.pods_project.targets.find do |target|
      target.name == aggregate_target.label
    end
    product_reference = pods_target&.product_reference
    next unless product_reference&.path&.end_with?(".a")

    removed_count = 0
    aggregate_target.user_targets.each do |user_target|
      user_target.frameworks_build_phase.files.dup.each do |build_file|
        file_reference = build_file.file_ref
        next unless file_reference&.source_tree == "BUILT_PRODUCTS_DIR"
        next unless file_reference.path == product_reference.path

        build_file.remove_from_project
        removed_count += 1
      end

      projects_to_save[user_target.project.path] = user_target.project
    end

    if removed_count.positive?
      removed_products << product_reference.path
    else
      Pod::UI.puts "AMap aggregate product link already absent: #{product_reference.path}"
    end
  end

  if amap_aggregate_count.zero?
    raise Pod::Informative,
          "No CocoaPods aggregate target contains AMap; simulator linkage cleanup was not applied."
  end

  projects_to_save.each_value(&:save)
  unless removed_products.empty?
    Pod::UI.puts [
      "Removed simulator-incompatible AMap aggregate links",
      removed_products.join(", ")
    ].join(": ")
  end
end
