{
  "name": "max-voice-agent-kit",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "brand": "tsx scripts/brand.ts",
    "bench:audio": "tsx scripts/audio-bench/cli.ts",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build && npm run build:sdk",
    "build:sdk": "node -e \"require('node:fs').rmSync('dist/sdk',{recursive:true,force:true})\" && vite build -c vite.sdk.config.ts && vite build -c vite.sdk.config.ts --mode iife && tsc -p sdk/tsconfig.build.json",
    "pack:sdk": "npm run build:sdk && tsx scripts/pack-sdk.ts",
    "cloud:backup": "tsx scripts/cloud-backup.ts",
    "cloud:credit": "tsx scripts/cloud-credit.ts",
    "cloud:reencrypt": "tsx scripts/cloud-reencrypt.ts",
    "cloud:reset-password": "tsx scripts/cloud-reset-password.ts",
    "cloud:settle": "tsx scripts/cloud-settle.ts",
    "check:sdk": "tsc -p sdk/tsconfig.json --noEmit",
    "generate:protocol": "tsx scripts/generate-agent-protocol.ts",
    "agent:test": "tsx scripts/agent-test/cli.ts",
    "check:protocol": "tsx scripts/generate-agent-protocol.ts --check",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:protocol && npm run format:check && npm run lint && npm run check:dead-code && npm run check:rdk && npm run check:sdk && npm run check:scripts && npm test && npm run test:fault-matrix && npm run build",
    "check:dead-code": "knip",
    "check:rdk": "tsc -p rdk/agent/tsconfig.json --noEmit",
    "check:scripts": "tsc -p scripts/tsconfig.json --noEmit && tsc -p scripts/synthetic-qa/browser/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build:sdk && playwright test",
    "test:rdk-vision": "python3 -m pytest -c rdk/vision/pytest.ini -m \"not hardware\" --strict-markers rdk/vision/tests",
    "test:speech": "cd speech-server && uv run --frozen pytest -q",
    "test:watch": "vitest",
    "test:fault-matrix": "tsx scripts/testing-fault-matrix.ts",
    "test:release-gate": "tsx scripts/testing-release-gate.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multicast-dns": "^7.2.5",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.48.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "opusscript": "^0.1.1",
    "werift": "^0.28.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
